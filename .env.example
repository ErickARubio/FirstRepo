# ─── PLANTILLA DE CREDENCIALES ───────────────────────────────────────────────
# Proyecto: Video-Ensayos Cartográficos (ZMVM)
# Copiar este archivo como .env y llenar los valores reales.
# NUNCA subir .env a GitHub. Solo .env.example va al repositorio.
# Ver instrucciones detalladas en: 00_Orchestrator/CREDENTIALS_GUIDE.md

# ─── VOZ ─────────────────────────────────────────────────────────────────────
# ElevenLabs — síntesis de voz IA
# Registro: https://elevenlabs.io → Sign Up → Profile → API Keys
ELEVENLABS_API_KEY=

# ─── GENERACIÓN DE IMÁGENES IA ────────────────────────────────────────────────
# Google AI Studio — Imagen 3 + Gemini 2.0 Flash (generación de assets visuales)
# Registro: https://aistudio.google.com/app/apikey → Create API Key (gratis)
# Da acceso a: Imagen 3 (calidad máxima) y Gemini 2.0 Flash (texto + imagen)
GOOGLE_API_KEY=

# ─── BANCOS DE IMÁGENES (opcionales) ─────────────────────────────────────────
# Pexels — banco de imágenes gratuito
# Registro: https://www.pexels.com/api/ → Your API Key
PEXELS_API_KEY=

# Unsplash — banco de imágenes gratuito
# Registro: https://unsplash.com/developers → New Application
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Pixabay — banco de imágenes gratuito
# Registro: https://pixabay.com/api/docs/ → Tu API Key
PIXABAY_API_KEY=

# ─── DATOS ECONÓMICOS MÉXICO ──────────────────────────────────────────────────
# Banxico SIE API — series económicas del Banco de México
# Registro: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# INEGI API — indicadores nacionales
# Registro: https://www.inegi.org.mx/servicios/api_indicadores.html → Solicitar token
INEGI_TOKEN=

# ─── VISUALIZACIÓN ────────────────────────────────────────────────────────────
# Datawrapper — mapas y gráficos publicables
# Registro: https://app.datawrapper.de/account/api-tokens → Create API Token
DATAWRAPPER_TOKEN=

# ─── SIN TOKEN REQUERIDO ──────────────────────────────────────────────────────
# World Bank Open Data — no requiere clave, acceso directo por URL
# Documentación: https://api.worldbank.org/v2/
# WORLDBANK_API_KEY= (no necesario)
